#!/bin/sh
# Run a job-hunter script with the first Python 3.10+ that actually works.
#   sh jh tracker.py today
# Tries python3, python, `py -3`, then `uv run`. A Windows Store alias that
# exists but cannot start fails the version probe and is skipped.
here=$(dirname "$0")
script="$1"
shift
for py in python3 python "py -3"; do
  if $py -c "import sys; sys.exit(sys.version_info < (3, 10))" >/dev/null 2>&1; then
    exec $py "$here/$script" "$@"
  fi
done
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project --python 3.12 python "$here/$script" "$@"
fi
echo "job-hunter: no working Python 3.10+ found. Install Python (python.org) or uv (docs.astral.sh/uv)." >&2
exit 127
